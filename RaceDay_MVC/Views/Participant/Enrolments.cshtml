@model List<RaceDay_MVC.Models.RaceEnrolment>

@{
    //start of view configuration

    ViewData["Title"] = "My Enrolments";

    //end of view configuration
}

<!-- start of my enrolments page -->
<div class="container py-4">

    <!-- start of page heading -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">

        <div>

            <h1>My Enrolments 📋</h1>

            <p>
                View and manage your racing registrations.
            </p>

        </div>

        <a asp-controller="Events"
           asp-action="Index"
           class="btn btn-primary">

            Explore Events 🏃

        </a>

    </div>
    <!-- end of page heading -->
    <!-- start of enrolment statistics -->
    <div class="row g-3 mb-4">

        <div class="col-md-6">

            <div class="card shadow-sm">

                <div class="card-body text-center">

                    <h4>Confirmed Registrations</h4>

                    <h2>
                        @Model.Count(e => e.Status == "Confirmed")
                    </h2>

                </div>

            </div>

        </div>

        <div class="col-md-6">

            <div class="card shadow-sm">

                <div class="card-body text-center">

                    <h4>Cancelled Registrations</h4>

                    <h2>
                        @Model.Count(e => e.Status == "Cancelled")
                    </h2>

                </div>

            </div>

        </div>

    </div>
    <!-- end of enrolment statistics -->
    <!-- start of enrolments table -->
    <div class="card shadow-sm">

        <div class="card-body">

            <h3 class="mb-3">
                My Race Registrations
            </h3>

            @if (Model.Count == 0)
            {
                @* start of if *@

                <div class="text-center py-5">

                    <h4>
                        No Enrolments Yet 😢
                    </h4>

                    <p>
                        You have not registered for any races.
                    </p>

                    <a asp-controller="Events"
                       asp-action="Index"
                       class="btn btn-primary">

                        Browse Racing Events

                    </a>

                </div>

                @* end of if *@
            }
            else
            {
                @* start of else *@

                <div class="table-responsive">

                    <table class="table table-striped align-middle">

                        <thead>
                            <tr>
                                <th>Event Name</th>
                                <th>Category</th>
                                <th>Distance</th>
                                <th>Event Date</th>
                                <th>Registration Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                @* start of foreach *@

                                <tr>

                                    <td>
                                        @item.EventName
                                    </td>

                                    <td>
                                        @item.CategoryName
                                    </td>

                                    <td>
                                        @item.DistanceKM km
                                    </td>

                                    <td>
                                        @item.EventDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @item.EnrolmentDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>

                                        @if (item.Status == "Confirmed")
                                        {
                                            @* start of if *@

                                            <span class="badge text-bg-success">
                                                Confirmed
                                            </span>

                                            @* end of if *@
                                        }
                                        else if (item.Status == "Cancelled")
                                        {
                                            @* start of else if *@

                                            <span class="badge text-bg-secondary">
                                                Cancelled
                                            </span>

                                            @* end of else if *@
                                        }
                                        else
                                        {
                                            @* start of else *@

                                            <span class="badge text-bg-warning">
                                                @item.Status
                                            </span>

                                            @* end of else *@
                                        }

                                    </td>

                                    <td>

                                        <div class="d-flex gap-2 flex-wrap">

                                            <!-- view the event -->
                                            <a asp-controller="Events"
                                               asp-action="Details"
                                               asp-route-id="@item.EventID"
                                               class="btn btn-primary btn-sm">

                                                View Event

                                            </a>

                                            @if (item.CanCancel)
                                            {
                                                @* start of if *@

                                                <!-- start of cancellation form -->
                                                <form asp-controller="Participant"
                                                      asp-action="Cancel"
                                                      method="post"
                                                      onsubmit="return confirm('Are you sure you want to cancel this registration?');">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@item.EnrolmentID" />

                                                    <button type="submit"
                                                            class="btn btn-danger btn-sm">

                                                        Cancel Registration

                                                    </button>

                                                </form>
                                                <!-- end of cancellation form -->
                                                @* end of if *@
                                            }

                                        </div>

                                    </td>

                                </tr>

                                @* end of foreach *@
                            }

                        </tbody>

                    </table>

                </div>

                @* end of else *@
            }

        </div>

    </div>
    <!-- end of enrolments table -->

</div>
<!-- end of my enrolments page -->
