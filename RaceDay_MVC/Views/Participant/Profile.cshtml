@model RaceDay_MVC.Models.ProfileForm

@{
    //start of view configuration

    ViewData["Title"] = "My Profile";

    //end of view configuration
}

<!-- start of participant profile page -->
<div class="container py-4">

    <!-- start of page heading -->
    <div class="raceday-profile-header mb-4">

        <h1>My Profile 👤</h1>

        <p>
            View and update your RaceDay account information.
        </p>

    </div>
    <!-- end of page heading -->


    <div class="row justify-content-center">

        <div class="col-lg-7">

            <!-- start of profile picture card -->
            <div class="card raceday-profile-card mb-4">

                <div class="card-body text-center p-4">

                    <!-- start of profile image -->
                    <div class="raceday-avatar mx-auto mb-3">

                        <span class="raceday-avatar-placeholder">
                            👤
                        </span>

                        <img src="@Url.Action("Current", "ProfilePictures")"
                             alt="Participant profile picture"
                             class="raceday-avatar-image"
                             onerror="this.style.display='none'" />

                    </div>
                    <!-- end of profile image -->

                    <h3 class="mb-3">
                        My Profile Picture 📸
                    </h3>

                    <p>
                        Upload a JPG, PNG or WebP image (maximum 2 MB).
                    </p>


                    <!-- start of image upload form -->
                    <form asp-controller="ProfilePictures"
                          asp-action="Upload"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <div class="mb-3">

                            <label for="participantImage"
                                   class="form-label">

                                Select Profile Picture

                            </label>

                            <input type="file"
                                   id="participantImage"
                                   name="image"
                                   class="form-control"
                                   accept=".jpg,.jpeg,.png,.webp"
                                   required />

                        </div>

                        <button type="submit"
                                class="btn btn-primary">

                            Upload Picture 📸

                        </button>

                    </form>
                    <!-- end of image upload form -->

                </div>

            </div>
            <!-- end of profile picture card -->
            <!-- start of personal information card -->
            <div class="card shadow-sm raceday-profile-card">

                <div class="card-body p-4">

                    <h3 class="mb-4">
                        Personal Information
                    </h3>

                    <!-- start of personal information form -->
                    <form asp-controller="Participant"
                          asp-action="Profile"
                          method="post">

                        @Html.AntiForgeryToken()

                        <!-- display validation errors -->
                        <div asp-validation-summary="All"
                             class="text-danger mb-3">
                        </div>


                        <!-- start of first name -->
                        <div class="mb-3">

                            <label asp-for="FirstName"
                                   class="form-label">

                                First Name

                            </label>

                            <input asp-for="FirstName"
                                   class="form-control"
                                   autocomplete="given-name"
                                   placeholder="Enter your first name" />

                            <span asp-validation-for="FirstName"
                                  class="text-danger">
                            </span>

                        </div>
                        <!-- end of first name -->
                        <!-- start of last name -->
                        <div class="mb-3">

                            <label asp-for="LastName"
                                   class="form-label">

                                Last Name

                            </label>

                            <input asp-for="LastName"
                                   class="form-control"
                                   autocomplete="family-name"
                                   placeholder="Enter your last name" />

                            <span asp-validation-for="LastName"
                                  class="text-danger">
                            </span>

                        </div>
                        <!-- end of last name -->
                        <!-- start of email -->
                        <div class="mb-4">

                            <label asp-for="Email"
                                   class="form-label">

                                Email Address

                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   autocomplete="email"
                                   placeholder="Enter your email address" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                        </div>
                        <!-- end of email -->
                        <!-- start of form buttons -->
                        <div class="d-flex gap-2 flex-wrap">

                            <button type="submit"
                                    class="btn btn-primary">

                                Save Changes 💾

                            </button>

                            <a asp-controller="Participant"
                               asp-action="Dashboard"
                               class="btn btn-secondary">

                                Back to Dashboard 🌤️

                            </a>

                        </div>
                        <!-- end of form buttons -->

                    </form>
                    <!-- end of personal information form -->

                </div>

            </div>
            <!-- end of personal information card -->

        </div>

    </div>

</div>
<!-- end of participant profile page -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
