@model List<RaceDay_MVC.Models.RaceEvent>

@{
    //start of view configuration

    ViewData["Title"] = "Available Events";

    //end of view configuration
}

<!-- start of participant events page -->
<div class="container py-4">

    <!-- start of page heading -->
    <div class="mb-4">

        <h1>Available Racing Events 🏃</h1>

        <p>
            Discover upcoming races and find your next challenge.
        </p>

    </div>
    <!-- end of page heading -->
    <!-- start of racing events -->
    @if (Model.Count == 0)
    {
        @* start of if *@

        <div class="card shadow-sm">

            <div class="card-body text-center py-5">

                <h3>No Upcoming Events 😢</h3>

                <p>
                    There are currently no upcoming racing events.
                </p>

            </div>

        </div>

        @* end of if *@
    }
    else
    {
        @* start of else *@

        <div class="row g-4">

            @foreach (var item in Model)
            {
                @* start of foreach *@

                <div class="col-md-6 col-lg-4">

                    <div class="card shadow-sm h-100">

                        <div class="card-body d-flex flex-column">

                            <h4>
                                @item.EventName
                            </h4>

                            <p>
                                <strong>Event Type:</strong>
                                @item.EventType
                            </p>

                            <p>
                                <strong>Location:</strong>
                                @item.Location
                            </p>

                            <p>
                                <strong>Date:</strong>
                                @item.EventDate.ToString("dd MMM yyyy")
                            </p>

                            <p>
                                @item.Description
                            </p>

                            
                            <div class="mt-auto">

                                <!-- start of event details button -->
                                <a asp-controller="Participant"
                                   asp-action="Details"
                                   asp-route-id="@item.EventID"
                                   class="btn btn-primary w-100">

                                    View Event Details 🪧

                                </a>
                                <!-- end of event details button -->

                            </div>


                        </div>

                    </div>

                </div>

                @* end of foreach *@
            }

        </div>

        @* end of else *@
    }

    <!-- end of racing events -->

</div>
<!-- end of participant events page -->
