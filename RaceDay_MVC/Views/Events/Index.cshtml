@model List<RaceDay_MVC.Models.RaceEvent>

@{
    //start of view configuration

    ViewData["Title"] = "Explore Events";

    //end of view configuration
}

<!-- start of events page -->
<div class="container py-4">

    <!-- start of heading -->
    <div class="mb-4">

        <h1>Explore Racing Events 🏃</h1>

        <p>
            Discover upcoming running, walking and cycling events.
        </p>

    </div>
    <!-- end of heading -->
    <!-- start of event search and filters -->
    <form asp-controller="Events"
          asp-action="Index"
          method="get"
          class="row g-3 mb-4">

        <!-- search event name or location -->
        <div class="col-md-4">

            <label class="form-label">
                Search Events
            </label>

            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   placeholder="Event name or location"
                   class="form-control" />

        </div>

        <!-- event type filter -->
        <div class="col-md-3">

            <label class="form-label">
                Event Type
            </label>

            <select name="type" class="form-select">

                <option value="">All Types</option>

                <option value="Running"
                        selected="@(ViewBag.Type == "Running")">
                    Running
                </option>

                <option value="Walking"
                        selected="@(ViewBag.Type == "Walking")">
                    Walking
                </option>

                <option value="Cycling"
                        selected="@(ViewBag.Type == "Cycling")">
                    Cycling
                </option>

            </select>

        </div>

        <!-- event date filter -->
        <div class="col-md-3">

            <label class="form-label">
                Event Date
            </label>

            <select name="period" class="form-select">

                <option value="">All Events</option>

                <option value="upcoming"
                        selected="@(ViewBag.Period == "upcoming")">
                    Upcoming
                </option>

                <option value="previous"
                        selected="@(ViewBag.Period == "previous")">
                    Previous
                </option>

            </select>

        </div>

        <!-- event search button -->
        <div class="col-md-2 d-flex align-items-end">

            <button type="submit"
                    class="btn btn-primary w-100">

                Search 🔎

            </button>

        </div>

        <!-- event sorting -->
        <div class="col-md-4">

            <label class="form-label">
                Sort By
            </label>

            <select name="sort" class="form-select">

                <option value="earliest"
                        selected="@(ViewBag.Sort == null || ViewBag.Sort == "earliest")">
                    Date: Earliest First
                </option>

                <option value="latest"
                        selected="@(ViewBag.Sort == "latest")">
                    Date: Latest First
                </option>

                <option value="name"
                        selected="@(ViewBag.Sort == "name")">
                    Event Name: A-Z
                </option>

            </select>

        </div>

        <div class="col-md-3 d-flex align-items-end">

            <a asp-controller="Events"
               asp-action="Index"
               class="btn btn-secondary w-100">

                Clear Filters

            </a>

        </div>

    </form>
    <!-- end of event search and filters -->
    <!-- start of event cards -->
    <div class="row g-4">

        @foreach (var item in Model)
        {
            @* start of foreach *@

            <div class="col-md-6 col-lg-4">

                <div class="card shadow-sm h-100">

                    <div class="card-body">

                        <h3>@item.EventName</h3>

                        <p>
                            <strong>Type:</strong>
                            @item.EventType
                        </p>

                        <p>
                            <strong>Date:</strong>
                            @item.EventDate.ToString("dd MMM yyyy")
                        </p>

                        <p>
                            <strong>Location:</strong>
                            @item.Location
                        </p>

                        <a asp-controller="Events"
                           asp-action="Details"
                           asp-route-id="@item.EventID"
                           class="btn btn-primary">

                            View Event 🏁

                        </a>

                    </div>

                </div>

            </div>

            @* end of foreach *@
        }

    </div>
    <!-- end of event cards -->
    @if (Model.Count == 0)
    {
        @* start of if *@

        <div class="text-center py-5">

            <h3>No Events Found 😢</h3>

            <p>
                There are no events matching your search.
            </p>

        </div>

        @* end of if *@
    }

</div>
<!-- end of events page -->
