@model RegisterForm

@{
    //start of view configuration

    ViewData["Title"] = "Register";

    //end of view configuration
}

<!-- start of registration container -->
<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-8 col-lg-6">

            <!-- start of registration card -->
            <div class="card shadow-lg raceday-auth-card">

                <div class="card-body p-4 p-md-5">

                    <!-- start of heading -->
                    <h2 class="text-center mb-3">
                        Join RaceDay 🌿
                    </h2>

                    <p class="text-center text-muted mb-4">
                        Your next outdoor adventure starts here.
                        Create your RaceDay account.
                    </p>
                    <!-- end of heading -->
                    <!-- start of registration form -->
                    <form asp-controller="Account"
                          asp-action="Register"
                          method="post">

                        @Html.AntiForgeryToken()

                        <!-- display validation errors -->
                        <div asp-validation-summary="All"
                             class="text-danger mb-3">
                        </div>


                        <!-- start of first name -->
                        <div class="mb-3">

                            <label asp-for="FirstName"
                                   class="form-label">
                                First Name
                            </label>

                            <input asp-for="FirstName"
                                   class="form-control"
                                   placeholder="Enter your first name"
                                   autocomplete="given-name" />

                            <span asp-validation-for="FirstName"
                                  class="text-danger">
                            </span>

                        </div>
                        <!-- end of first name -->
                        <!-- start of last name -->
                        <div class="mb-3">

                            <label asp-for="LastName"
                                   class="form-label">
                                Last Name
                            </label>

                            <input asp-for="LastName"
                                   class="form-control"
                                   placeholder="Enter your last name"
                                   autocomplete="family-name" />

                            <span asp-validation-for="LastName"
                                  class="text-danger">
                            </span>

                        </div>
                        <!-- end of last name -->
                        <!-- start of email -->
                        <div class="mb-3">

                            <label asp-for="Email"
                                   class="form-label">
                                Email Address
                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   placeholder="Enter your email"
                                   autocomplete="email" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                        </div>
                        <!-- end of email -->
                        <!-- start of password -->
                        <div class="mb-3">

                            <label asp-for="Password"
                                   class="form-label">
                                Password
                            </label>

                            <input asp-for="Password"
                                   type="password"
                                   class="form-control"
                                   placeholder="Create a password"
                                   autocomplete="new-password" />

                            <span asp-validation-for="Password"
                                  class="text-danger">
                            </span>

                        </div>
                        <!-- end of password -->
                        <!-- start of account type -->
                        <div class="mb-4">

                            <label asp-for="RoleID"
                                   class="form-label">
                                Account Type
                            </label>

                            <select asp-for="RoleID"
                                    class="form-select">

                                <option value="1">
                                    Organiser
                                </option>

                                <option value="2">
                                    Participant
                                </option>

                            </select>

                            <span asp-validation-for="RoleID"
                                  class="text-danger">
                            </span>

                        </div>
                        <!-- end of account type -->
                        <!-- start of register button -->
                        <button type="submit"
                                class="btn btn-primary w-100">

                            Create Account 🏃

                        </button>
                        <!-- end of register button -->

                    </form>
                    <!-- end of registration form -->
                    <!-- start of login link -->
                    <p class="text-center mt-4 mb-0">

                        Already have an account?

                        <a asp-controller="Account"
                           asp-action="Login">

                            Login Here

                        </a>

                    </p>
                    <!-- end of login link -->

                </div>

            </div>
            <!-- end of registration card -->

        </div>

    </div>

</div>
<!-- end of registration container -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
