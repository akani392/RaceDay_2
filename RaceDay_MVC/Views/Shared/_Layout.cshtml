@using Microsoft.AspNetCore.Http

@{
    //start of view configuration

    string? user_role = Context.Session.GetString("Role");
    string? user_name = Context.Session.GetString("Name");
    string? api_cookie = Context.Session.GetString("ApiCookie");

    bool logged_in = !string.IsNullOrEmpty(api_cookie);
    bool is_organiser = logged_in &&
    string.Equals(
        user_role?.Trim(),
        "Organiser",
        StringComparison.OrdinalIgnoreCase
    );
    bool is_participant = logged_in && string.Equals(user_role,"Participant",StringComparison.OrdinalIgnoreCase);

    //wnd of view configuration
}

<!DOCTYPE html>
<html lang="en">

    <head>
        <!-- start of head-->
        <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <title>@ViewData["Title"] - RaceDay</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>

        <!-- end of head-->
    </head>

    <body>
        <!--start of navigation-->

        <header>
            <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
                <div class="container">
                    <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                        RaceDay🏃
                    </a>

                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                        <span class="navbar-toggler-icon">

                        </span>
                    </button>

                    <div class="collapse navbar-collapse" id="mainNavbar">
                        <ul class="navbar-nav me-auto">

                        @if (!logged_in)
                            {
                                //start of if

                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Home" asp-action="Index">
                                        Home
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Participant" asp-action="Index">
                                        Events
                                    </a>
                                </li>

                                //end of if
                            }

                           
                        <!-- start of organiser navigation -->
                        @if (is_organiser)
                        {
                            @* start of if *@

                            <!-- organiser dashboard -->
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Organiser"
                                   asp-action="Index">

                                    Dashboard

                                </a>
                            </li>

                            <!-- manage events -->
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Organiser"
                                   asp-action="Events">

                                    My Events

                                </a>
                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Organiser"
                                   asp-action="Events">

                                    Select Event for Enrolments 📋

                                </a>

                            </li>
                           
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Organiser"
                                   asp-action="Events">

                                    Select Event for Results 🏆

                                </a>

                            </li>

                            @* end of if *@
                        }

                        <!-- end of organiser navigation -->
                        <!-- start of participant navigation -->
                        @if (is_participant)
                        {
                            @* start of if *@

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Events"
                                   asp-action="Index">
                                    Events 🏃
                                </a>
                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Participant"
                                   asp-action="Enrolments">

                                    My Enrolments 📋

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Participant"
                                   asp-action="Results">

                                    My Results 🏆

                                </a>

                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Participant"
                                   asp-action="Profile">
                                    Profile 👤
                                </a>
                            </li>

                            

                            @* end of if *@
                        }
                        <!-- end of participant navigation -->

                        </ul>

                        <!--start of accont navigation-->

                        <ul class="navbar-nav">

                            @if (logged_in)
                            {
                                //start of if

                                <li class="nav-item">
                                    <span class="navbar-text me-3">
                                        Welcome👋 @user_name you are an @user_role
                                    </span>
                                </li>

                                <li class="nav-item">

                                    <form asp-controller="Account" asp-action="Logout" method="post">

                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-light">
                                            Logout
                                        </button>
                                    </form>
                                </li>

                                //end of if
                            }

                            else
                            {
                                //start of else

                                <li class="nav-item me-2">
                                    <a class="btn btn-outline-light" asp-controller="Account" asp-action="Login">
                                        Login
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="btn btn-warning" asp-controller="Account" asp-action="Register">
                                        Register
                                    </a>
                                </li>

                                //end of else
                            }
                        </ul>

                        <!--end of account navigation-->
                    </div>
                </div>

            </nav>
        </header>

        <!--end of navigation-->

        <!--start of the main content-->
        <main class="container py-4">
            @if (TempData["Success"]!= null)
            {
                //start of if
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
                //end of if
            }

            @if(TempData["Error"] != null)
            {
                //start of if

                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>

                //end of if

                
            }

        <!--display content of the current razor view-->
         @RenderBody()

        </main>
        <!--end of main content-->

        <!--start of footer-->

        <footer class="bg-dark text-white py-3 mt-5">

            <div class="container text-center">

                <p class="mb-0">
                    <!--date and time of the events-->
                    &copy;@DateTime.Now.Year RaceDay.
                    Made for racers and organisers
                    ST10481917
                </p>
            </div>
        </footer>

        <!--end of footer-->

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
        </script>

        @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>