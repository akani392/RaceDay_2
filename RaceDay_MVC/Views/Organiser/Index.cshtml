@{
    //start of view configuration

    ViewData["Title"] = "Organiser Dashboard";

    //end of view configuration
}

<!-- start of organiser dashboard-->
<div class="container py-4">
    <h1 class="mb-3">
        Organiser Dashboard
    </h1>

    <p class="lead">
        Welcome to your RaceDay event management dashboard👋
    </p>

    <!-- start of dashboard cards-->
    <div class="row g-4 mt-3">

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4>
                        My Events
                    </h4>

                    <p>
                        Create, update and manage your racing events
                    </p>

                    <a asp-controller="Organiser" asp-action="Events" class="btn btn-primary">
                        Mange your events
                    </a>


                </div>
            </div>
        </div>

        <div class="col-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4>
                        Enrolments

                    </h4>

                    <p>
                        view the participants that have registered for your events
                    </p>

                    <a asp-controller="Organiser" asp-action="Events" class="btn btn-primary">
                        View Event Enrolments
                    </a>
                </div>
            </div>
        </div>

        <div class="col-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4>
                        Race Results
                    </h4>

                    <p>
                        Capture and publish participants race results
                    </p>

                    <a asp-controller="Organiser" asp-action="Events" class="btn btn-primary">
                        Manage Race Results
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- end of dashboard cards-->
</div>

<!--end of organiser dashboard-->