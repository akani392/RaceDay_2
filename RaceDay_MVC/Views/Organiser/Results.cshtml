@model RaceDay_MVC.Models.ResultsPageViewModel

@{
    //start of view configuration

    ViewData["Title"] = "Race Results";

    //end of view configuration
}

<!-- start of results page -->
<div class="container py-4">

    <!-- start of page heading -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">

        <div>

            <h1>Race Results 🏆</h1>

            <p>
                @Model.EventName
            </p>

        </div>

        <a asp-controller="Organiser"
           asp-action="Events"
           class="btn btn-secondary">

            Back to Events

        </a>

    </div>
    <!-- end of page heading -->
    <!-- start of results statistics -->
    <div class="row g-4 mb-4">

        <div class="col-md-6">

            <div class="card shadow-sm raceday-result-card">

                <div class="card-body text-center">

                    <h3>Confirmed Participants</h3>

                    <h2>@Model.Rows.Count</h2>

                </div>

            </div>

        </div>

        <div class="col-md-6">

            <div class="card shadow-sm raceday-result-card">

                <div class="card-body text-center">

                    <h3>Results Captured</h3>

                    <h2>@Model.TotalCaptured</h2>

                </div>

            </div>

        </div>

    </div>
    <!-- end of results statistics -->
    <!-- start of results table -->
    <div class="card shadow-sm raceday-result-card">

        <div class="card-body">

            <h3 class="mb-3">
                Participant Results
            </h3>

            @if (Model.Rows.Count == 0)
            {
                @* start of if *@

                <div class="text-center py-4">

                    <h4>No Confirmed Participants 😢</h4>

                    <p>
                        This event does not have any confirmed
                        participants yet.
                    </p>

                </div>

                @* end of if *@
            }
            else
            {
                @* start of else *@

                <div class="table-responsive">

                    <table class="table table-striped align-middle">

                        <thead>
                            <tr>
                                <th>Participant</th>
                                <th>Category</th>
                                <th>Finish Time</th>
                                <th>Position</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model.Rows)
                            {
                                @* start of foreach *@

                                <tr>

                                    <td>
                                        @item.Enrolment.ParticipantName
                                    </td>

                                    
                                    <!-- start of finish time -->
                                    <td>
                                        @if (item.Result != null)
                                        {
                                            @* start of if *@

                                            @item.Result.FinishTime.ToString(@"hh\:mm\:ss")

                                            @* end of if *@
                                        }
                                        else
                                        {
                                            @* start of else *@

                                            <span class="text-muted">
                                                -
                                            </span>

                                            @* end of else *@
                                        }
                                    </td>
                                    <!-- end of finish time -->


                                    
                                    <td>

                                        @if (item.Result == null)
                                        {
                                            @* start of if *@

                                            @if (ViewBag.EventDate != null &&
                                                 (DateTime)ViewBag.EventDate <= DateTime.Now)
                                            {
                                                <a asp-controller="Organiser"
                                                   asp-action="CaptureResult"
                                                   asp-route-eventId="@Model.EventID"
                                                   asp-route-enrolmentId="@item.Enrolment.EnrolmentID"
                                                   class="btn btn-primary btn-sm">

                                                    Capture Result 🏁

                                                </a>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-secondary">
                                                    Awaiting Race Date
                                                </span>
                                            }

                                            @* end of if *@
                                        }
                                        
                                        else
                                        {
                                            @* start of else *@

                                            @item.Result.FinishTime.ToString(@"hh\:mm\:ss")

                                            @* end of else *@
                                        }

                                    </td>


                                    <td>

                                        @if (item.Result != null)
                                        {
                                            @item.Result.Position
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }

                                    </td>

                                    
                                   
                                    <!-- start of result action buttons -->
                                    <td>
                                        @if (item.Result == null)
                                        {
                                            @* start of if *@

                                            //check that the race date has passed
                                            @if (ViewBag.EventDate != null &&
                                                 (DateTime)ViewBag.EventDate <= DateTime.Now)
                                            {
                                                @* start of if *@

                                                <a asp-controller="Organiser"
                                                   asp-action="CaptureResult"
                                                   asp-route-eventId="@Model.EventID"
                                                   asp-route-enrolmentId="@item.Enrolment.EnrolmentID"
                                                   class="btn btn-primary btn-sm">

                                                    Capture Result 🏁

                                                </a>

                                                @* end of if *@
                                            }
                                            else
                                            {
                                                @* start of else *@

                                                <span class="badge text-bg-secondary">
                                                    Awaiting Race Date 📅
                                                </span>

                                                @* end of else *@
                                            }

                                            @* end of if *@
                                        }
                                        else
                                        {
                                            @* start of else *@

                                            <div class="d-flex align-items-center gap-2 flex-wrap">

                                                <!-- start of captured status -->
                                                <span class="raceday-status-badge raceday-status-captured">
                                                    Captured 🏆
                                                </span>
                                                <!-- end of captured status -->
                                                <!-- start of edit result -->
                                                @if (item.Result.CapturedByID ==
                                                     Context.Session.GetInt32("UserID"))
                                                {
                                                    @* start of if *@

                                                    <a asp-controller="Organiser"
                                                       asp-action="EditResult"
                                                       asp-route-eventId="@Model.EventID"
                                                       asp-route-enrolmentId="@item.Enrolment.EnrolmentID"
                                                       asp-route-resultId="@item.Result.ResultID"
                                                       class="btn btn-outline-primary btn-sm">

                                                        Edit ✏️

                                                    </a>

                                                    @* end of if *@
                                                }
                                                <!-- end of edit result -->

                                            </div>

                                            @* end of else *@
                                        }
                                    </td>
                                    <!-- end of result action buttons -->



                                </tr>

                                @* end of foreach *@
                            }

                        </tbody>

                    </table>

                </div>

                @* end of else *@
            }

        </div>

    </div>
    <!-- end of results table -->

</div>
<!-- end of results page -->
