
@model RaceDay_MVC.Models.EnrolmentsPageViewModel

@{
    //start of view configuration

    ViewData["Title"] = "Event Enrolments";

    //end of view configuration
}

<!-- start of enrolments page -->
<div class="container py-4">

    <!-- start of page heading -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">

        <div>

            <h1>Event Enrolments</h1>

            <p class="lead">
                @Model.EventName
            </p>

        </div>

        <a asp-controller="Organiser"
           asp-action="Events"
           class="btn btn-secondary">

            Back to Events

        </a>

    </div>
    <!-- end of page heading -->


    <!-- start of enrolment statistics -->
    <div class="row g-4 mb-4">

        <!-- total enrolments -->
        <div class="col-md-4">

            <div class="card h-100 shadow-sm">

                <div class="card-body text-center">

                    <h4>Confirmed Enrolments</h4>

                    <h2>@Model.TotalConfirmed</h2>

                </div>

            </div>

        </div>

        <!-- total capacity -->
        <div class="col-md-4">

            <div class="card h-100 shadow-sm">

                <div class="card-body text-center">

                    <h4>Total Capacity</h4>

                    <h2>@Model.TotalCapacity</h2>

                </div>

            </div>

        </div>

        <!-- remaining places -->
        <div class="col-md-4">

            <div class="card h-100 shadow-sm">

                <div class="card-body text-center">

                    <h4>Available Places</h4>

                    <h2>@Model.AvailablePlaces</h2>

                </div>

            </div>

        </div>

    </div>
    <!-- end of enrolment statistics -->


    <!-- start of category statistics -->
    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <h3 class="mb-3">Category Availability</h3>

            @if (Model.Categories.Count == 0)
            {
                <!-- start of if -->

                <p>
                    No categories have been created for this event.
                </p>

                <!-- end of if -->
            }
            else
            {
                <!-- start of else -->

                <div class="table-responsive">

                    <table class="table table-striped">

                        <thead>
                            <tr>
                                <th>Category</th>
                                <th>Distance</th>
                                <th>Confirmed</th>
                                <th>Maximum</th>
                                <th>Available</th>
                            </tr>
                        </thead>

                        <tbody>

                          
                            @foreach (var category in Model.Categories)
                            {
                                @* start of foreach *@

                                //calculate confirmed registrations for this category
                                var registered = Model.Enrolments.Count(e =>
                                    e.CategoryID == category.CategoryID &&
                                    string.Equals(
                                        e.Status,
                                        "Confirmed",
                                        StringComparison.OrdinalIgnoreCase
                                    )
                                );

                                //calculate the remaining spaces
                                var available = Math.Max(
                                    0,
                                    category.MaxParticipants - registered
                                );

                                <tr>

                                    <td>@category.CategoryName</td>

                                    <td>@category.DistanceKM km</td>

                                    <td>@registered</td>

                                    <td>@category.MaxParticipants</td>

                                    <td>@available</td>

                                </tr>

                                @* end of foreach *@
                            }
  

                        </tbody>

                    </table>

                </div>

                <!-- end of else -->
            }

        </div>

    </div>
    <!-- end of category statistics -->

    <!-- start of enrolment filters -->
    <div class="card shadow-sm mb-4 raceday-enrolment-card">

        <div class="card-body">

            <h3 class="mb-3">
                Filter Registrations 🔎
            </h3>

            <form asp-controller="Organiser"
                  asp-action="Enrolments"
                  method="get"
                  class="row g-3">

                <!-- keep selected event id -->
                <input type="hidden"
                       name="id"
                       value="@Model.EventID" />

                <!-- start of category filter -->
                <div class="col-md-5">

                    <label class="form-label">
                        Race Category
                    </label>

                    <select name="categoryId"
                            class="form-select">

                        <option value="">
                            All Categories
                        </option>

                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.CategoryID"
                                    selected="@(ViewBag.SelectedCategoryID == category.CategoryID)">

                                @category.CategoryName

                            </option>
                        }

                    </select>

                </div>
                <!-- end of category filter -->
                <!-- start of status filter -->
                <div class="col-md-4">

                    <label class="form-label">
                        Registration Status
                    </label>

                    <select name="status"
                            class="form-select">

                        <option value="">
                            All Statuses
                        </option>

                        <option value="Confirmed"
                                selected="@(ViewBag.SelectedStatus == "Confirmed")">

                            Confirmed

                        </option>

                        <option value="Cancelled"
                                selected="@(ViewBag.SelectedStatus == "Cancelled")">

                            Cancelled

                        </option>

                    </select>

                </div>
                <!-- end of status filter -->
                <!-- start of filter button -->
                <div class="col-md-3 d-flex align-items-end">

                    <button type="submit"
                            class="btn btn-primary w-100">

                        Apply Filters

                    </button>

                </div>
                <!-- end of filter button -->

            </form>

            <a asp-controller="Organiser"
               asp-action="Enrolments"
               asp-route-id="@Model.EventID"
               class="btn btn-outline-secondary mt-3">

                Clear Filters

            </a>

        </div>

    </div>
    <!-- end of enrolment filters -->
    @{
        //start of participant filtering

        //get selected category
        int? selected_category =
            ViewBag.SelectedCategoryID;

        //get selected registration status
        string selected_status =
            ViewBag.SelectedStatus ?? "";

        //start with all enrolments for the event
        var filtered_enrolments = Model.Enrolments.AsEnumerable();

        //filter by selected category
        if (selected_category.HasValue)
        {
            filtered_enrolments = filtered_enrolments.Where(e =>
                e.CategoryID == selected_category.Value);
        }

        //filter by registration status
        if (!string.IsNullOrWhiteSpace(selected_status))
        {
            filtered_enrolments = filtered_enrolments.Where(e =>
                string.Equals(
                    e.Status,
                    selected_status,
                    StringComparison.OrdinalIgnoreCase
                ));
        }

        //convert filtered results into a list
        var displayed_enrolments = filtered_enrolments.ToList();

        //end of participant filtering
    }


    <!-- start of participants table -->
    <div class="card shadow-sm raceday-enrolment-card">

        <div class="card-body">

            <h3 class="mb-3">Registered Participants</h3>

            @if (displayed_enrolments.Count == 0)
            {
                <!-- start of if -->

                <div class="text-center py-4">

                    <h4>No Enrolments Yet</h4>

                    <p>
                        No participants have registered
                        for this event yet.
                    </p>

                </div>

                <!-- end of if -->
            }
            else
            {
                <!-- start of else -->

                <div class="table-responsive">

                    <table class="table table-striped">

                        <thead>
                            <tr>
                                <th>Enrolment ID</th>
                                <th>Participant</th>
                                <th>Category</th>
                                <th>Date Enrolled</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var enrolment in displayed_enrolments)
                            {
                                <!-- start of foreach -->

                                <tr>

                                    <td>
                                        #@enrolment.EnrolmentID
                                    </td>

                                    <td>
                                        @enrolment.ParticipantName
                                    </td>

                                    <td>
                                        @enrolment.CategoryName
                                    </td>

                                    <td>
                                        @enrolment.EnrolmentDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>

                                        @if (enrolment.Status == "Confirmed")
                                        {
                                            <!-- start of if -->

                                            <span class="badge text-bg-success">
                                                Confirmed
                                            </span>

                                            <!-- end of if -->
                                        }
                                        else
                                        {
                                            <!-- start of else -->

                                            <span class="badge text-bg-secondary">
                                                @enrolment.Status
                                            </span>

                                            <!-- end of else -->
                                        }

                                    </td>

                                </tr>

                                <!-- end of foreach -->
                            }

                        </tbody>

                    </table>

                </div>

                <!-- end of else -->
            }

        </div>

    </div>
    <!-- end of participants table -->

</div>
<!-- end of enrolments page -->
