@model RaceDay_MVC.Models.EditResultForm

@{
    //start of view configuration

    ViewData["Title"] = "Edit Race Result";

    //end of view configuration
}

<!-- start of edit result page -->
<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-8 col-lg-7">

            <!-- start of edit result card -->
            <div class="card shadow-lg raceday-result-card">

                <div class="card-body p-4 p-md-5">

                    <!-- start of page heading -->
                    <h2 class="mb-3">
                        Edit Race Result 🏆
                    </h2>

                    <p class="text-muted mb-4">
                        Correct the participant's finishing
                        time or position.
                    </p>
                    <!-- end of page heading -->
                    <!-- start of edit form -->
                    <form asp-controller="Organiser"
                          asp-action="EditResult"
                          method="post">

                        @Html.AntiForgeryToken()

                        <!-- keep existing identifiers -->
                        <input asp-for="ResultID"
                               type="hidden" />

                        <input asp-for="EventID"
                               type="hidden" />

                        <input asp-for="EnrolmentID"
                               type="hidden" />

                        <!-- display validation errors -->
                        <div asp-validation-summary="All"
                             class="text-danger mb-3">
                        </div>


                        <!-- start of enrolment information -->
                        <div class="mb-3">

                            <label class="form-label">
                                Enrolment ID
                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="@Model.EnrolmentID"
                                   disabled />

                        </div>
                        <!-- end of enrolment information -->
                        <!-- start of finish time -->
                        <div class="mb-3">

                            <label asp-for="FinishTime"
                                   class="form-label">
                                Finish Time ⏱️
                            </label>

                            <input asp-for="FinishTime"
                                   type="text"
                                   class="form-control"
                                   placeholder="01:25:30" />

                            <small class="text-muted">
                                Enter time as hours:minutes:seconds.
                            </small>

                            <span asp-validation-for="FinishTime"
                                  class="text-danger">
                            </span>

                        </div>
                        <!-- end of finish time -->
                        <!-- start of position -->
                        <div class="mb-4">

                            <label asp-for="Position"
                                   class="form-label">
                                Finishing Position 🥇
                            </label>

                            <input asp-for="Position"
                                   type="number"
                                   min="1"
                                   class="form-control" />

                            <span asp-validation-for="Position"
                                  class="text-danger">
                            </span>

                        </div>
                        <!-- end of position -->
                        <!-- start of form buttons -->
                        <div class="d-flex gap-3 flex-wrap">

                            <button type="submit"
                                    class="btn btn-primary">

                                Save Changes ✅

                            </button>

                            <a asp-controller="Organiser"
                               asp-action="Results"
                               asp-route-id="@Model.EventID"
                               class="btn btn-secondary">

                                Cancel

                            </a>

                        </div>
                        <!-- end of form buttons -->

                    </form>
                    <!-- end of edit form -->

                </div>

            </div>
            <!-- end of edit result card -->

        </div>

    </div>

</div>
<!-- end of edit result page -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
