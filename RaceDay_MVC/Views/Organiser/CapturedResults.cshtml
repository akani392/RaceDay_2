@model RaceDay_MVC.Models.ResultForm

@{
    //start of view configuration

    ViewData["Title"] = "Capture Race Result";

    //end of view configuration
}

<!-- start of capture result page -->
<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <!-- start of result form card -->
            <div class="card shadow-lg">

                <div class="card-body p-4">

                    <h2 class="mb-3">
                        Capture Race Result 🏆
                    </h2>

                    <p>
                        Enter the participant's finish time
                        and finishing position.
                    </p>

                    <!-- start of capture result form -->
                    <form asp-controller="Organiser"
                          asp-action="CaptureResult"
                          method="post">

                        @Html.AntiForgeryToken()

                        <!-- keep selected event and enrolment -->
                        <input asp-for="EventID" type="hidden" />
                        <input asp-for="EnrolmentID" type="hidden" />

                        <!-- display validation errors -->
                        <div asp-validation-summary="All"
                             class="text-danger mb-3">
                        </div>

                        <!-- enrolment number -->
                        <div class="mb-3">

                            <label class="form-label">
                                Enrolment ID
                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="@Model.EnrolmentID"
                                   disabled />

                        </div>

                        <!-- finish time -->
                        <div class="mb-3">

                            <label asp-for="FinishTime"
                                   class="form-label">

                                Finish Time

                            </label>

                            <input asp-for="FinishTime"
                                   type="text"
                                   class="form-control"
                                   placeholder="01:25:30" />

                            <small>
                                Enter time as hours:minutes:seconds.
                            </small>

                            <span asp-validation-for="FinishTime"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- finishing position -->
                        <div class="mb-4">

                            <label asp-for="Position"
                                   class="form-label">

                                Finishing Position

                            </label>

                            <input asp-for="Position"
                                   type="number"
                                   min="1"
                                   class="form-control" />

                            <span asp-validation-for="Position"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- form buttons -->
                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">

                                Save Result 🏆

                            </button>

                            <a asp-controller="Organiser"
                               asp-action="Results"
                               asp-route-id="@Model.EventID"
                               class="btn btn-secondary">

                                Cancel

                            </a>

                        </div>

                    </form>
                    <!-- end of capture result form -->

                </div>

            </div>
            <!-- end of result form card -->

        </div>

    </div>

</div>
<!-- end of capture result page -->
