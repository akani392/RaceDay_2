@model RaceDay_MVC.Models.CategoryForm

@{
    //start of view configuration

    bool is_editing = Model.CategoryID > 0;

    ViewData["Title"] = is_editing
        ? "Edit Category"
        : "Create Category";

    //end of view configuration
}

<!-- start of category form page -->
<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <!-- start of category card -->
            <div class="card shadow-lg">

                <div class="card-body p-4">

                    <h2 class="mb-4">
                        @(is_editing ? "Edit Category" : "Create Category")
                    </h2>

                    <!-- start of category form -->
                    <form asp-controller="Organiser"
                          asp-action="SaveCategory"
                          method="post">

                        @Html.AntiForgeryToken()

                        <!-- hidden category information -->
                        <input asp-for="EventID" type="hidden" />
                        <input asp-for="CategoryID" type="hidden" />

                        <!-- validation messages -->
                        <div asp-validation-summary="All"
                             class="text-danger mb-3">
                        </div>

                        <!-- category name -->
                        <div class="mb-3">

                            <label asp-for="CategoryName"
                                   class="form-label">
                                Category Name
                            </label>

                            <input asp-for="CategoryName"
                                   class="form-control"
                                   placeholder="e.g. 10KM Road Race" />

                            <span asp-validation-for="CategoryName"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- distance -->
                        <div class="mb-3">

                            <label asp-for="DistanceKM"
                                   class="form-label">
                                Distance (KM)
                            </label>

                            <input asp-for="DistanceKM"
                                   type="number"
                                   step="0.01"
                                   min="0.01"
                                   class="form-control" />

                            <span asp-validation-for="DistanceKM"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- maximum participants -->
                        <div class="mb-4">

                            <label asp-for="MaxParticipants"
                                   class="form-label">
                                Maximum Participants
                            </label>

                            <input asp-for="MaxParticipants"
                                   type="number"
                                   min="1"
                                   class="form-control" />

                            <span asp-validation-for="MaxParticipants"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- form buttons -->
                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">

                                @(is_editing ? "Save Changes" : "Create Category")
                            </button>

                            <a asp-action="Categories"
                               asp-route-id="@Model.EventID"
                               class="btn btn-secondary">

                                Cancel
                            </a>

                        </div>

                    </form>
                    <!-- end of category form -->

                </div>

            </div>
            <!-- end of category card -->

        </div>

    </div>

</div>
<!-- end of category form page -->
