@model List<RaceDay_MVC.Models.RaceEvent>

@{
    //start of view configuration

    ViewData["Titile"] = "Manage Events";

        //end of view configuration
}

<!-- start of manage events page-->

<div class="container py-4">

    <!--start of page header-->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1> 
                Manage Events
            </h1>

            <p>
                View and manage all your racing events
            </p>
        </div>

        <a asp-controller="Organiser" asp-action="CreateEvent" class="btn btn-warning">

            ➕ Create Event

        </a>
    </div>

    <!--end of page header-->

    <!--start of events table-->
    <div class="card shadow-sm">

        <div class="card-body">

            @if (Model.Count == 0)
            {

                //start of if

                <div class="text-center py-5">
                    <h4>
                        No Events Found😢
                    </h4>

                    <p>
                        You have not created any racing Events
                    </p>

                    <a asp-action="CreateEvent" class="btn btn-warning">
                        Create Your First Event
                    </a>



                </div>

                //end of if
            }
            else
            {
                //start of else 

                <div class="table table-striped align-middle">

                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Event Name</th>
                                <th>Event Type</th>
                                <th>Location</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                //start of for each

                                <tr>
                                    <td>
                                        @item.EventName
                                    </td>
                                    <td>
                                        @item.EventType
                                    </td>
                                    <td>
                                        @item.Location
                                    </td>

                                    <td>
                                        <div class="d-flex gap-2 flex-wrap">
                                        

                                            <a asp-action="EditEvent" asp-route-id="@item.EventID"class="btn btn-sm btn-primary">
                                                Edit⚙️
                                            </a>

                                            <a asp-controller="Organiser" asp-action="Categories" asp-route-id="@item.EventID" class="btn btn-primary btn-5m">
                                                Categories 🪧
                                            </a>

                                            <form asp-action="DeleteEvent" asp-route-id ="@item.EventID" method="post" onsubmit="return confirm("Are you sure you want too delete this event?");">

                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-danger">
                                                    Delete🚮
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>

                                //end of for each
                            }
                        </tbody>
                    </table>
                </div>

                //end of else
            }
        </div>
    </div>
</div>


<!--end of manage events page-->