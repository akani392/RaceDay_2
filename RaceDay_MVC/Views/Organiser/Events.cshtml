@model List<RaceDay_MVC.Models.RaceEvent>

@{
    //start of view configuration

    ViewData["Title"] = "Manage Events";

    //end of view configuration
}

<!-- start of manage events page -->
<div class="container py-4">

    <!-- start of page header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">

        <div>
            <h1>Manage Events</h1>

            <p>
                View and manage all your racing events
            </p>
        </div>

        <a asp-controller="Organiser"
           asp-action="CreateEvent"
           class="btn btn-warning">

            ➕ Create Event

        </a>

    </div>
    <!-- end of page header -->
    <!-- start of events table -->
    <div class="card shadow-sm">

        <div class="card-body">

            @if (Model.Count == 0)
            {
                @* start of if *@

                <div class="text-center py-5">

                    <h4>
                        No Events Found 😢
                    </h4>

                    <p>
                        You have not created any racing events.
                    </p>

                    <a asp-controller="Organiser"
                       asp-action="CreateEvent"
                       class="btn btn-warning">

                        Create Your First Event

                    </a>

                </div>

                @* end of if *@
            }
            else
            {
                @* start of else *@

                <div class="table-responsive">

                    <table class="table table-striped align-middle">

                        <thead>
                            <tr>
                                <th>Event Name</th>
                                <th>Event Type</th>
                                <th>Event Date</th>
                                <th>Location</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                @* start of foreach *@

                                <tr>

                                    <td>
                                        @item.EventName
                                    </td>

                                    <td>
                                        @item.EventType
                                    </td>

                                    <td>
                                        @item.EventDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @item.Location
                                    </td>

                                    <td>

                                        <div class="d-flex gap-2 flex-wrap">

                                            <!-- start of edit event button -->
                                            <a asp-controller="Organiser"
                                               asp-action="EditEvent"
                                               asp-route-id="@item.EventID"
                                               class="btn btn-sm btn-primary">

                                                Edit ⚙️

                                            </a>
                                            <!-- end of edit event button -->
                                            <!-- start of categories button -->
                                            <a asp-controller="Organiser"
                                               asp-action="Categories"
                                               asp-route-id="@item.EventID"
                                               class="btn btn-sm btn-primary">

                                                Categories 🪧

                                            </a>
                                            <!-- end of categories button -->
                                            <!-- start of enrolments button -->
                                            <a asp-controller="Organiser"
                                               asp-action="Enrolments"
                                               asp-route-id="@item.EventID"
                                               class="btn btn-sm btn-primary">

                                                View Enrolments 📋

                                            </a>
                                            <!-- end of enrolments button -->
                                            <!-- start of results button -->

                                            <a asp-controller="Organiser"
                                               asp-action="Results"
                                               asp-route-id="@item.EventID"
                                               class="btn btn-primary btn-sm">

                                                Race Results 🏆

                                            </a>

                                            <!-- end of results button -->
                                            <!-- start of delete event form -->
                                            <form asp-controller="Organiser"
                                                  asp-action="DeleteEvent"
                                                  asp-route-id="@item.EventID"
                                                  method="post"
                                                  onsubmit="return confirm('Are you sure you want to delete this event?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger">

                                                    Delete 🚮

                                                </button>

                                            </form>
                                            <!-- end of delete event form -->

                                        </div>

                                    </td>

                                </tr>

                                @* end of foreach *@
                            }

                        </tbody>

                    </table>

                </div>

                @* end of else *@
            }

        </div>

    </div>
    <!-- end of events table -->

</div>
<!-- end of manage events page -->
