@model RaceDay_MVC.Models.ProfileForm

@{
    //start of view configuration

    ViewData["Title"] = "Organiser Profile";

    //end of view configuration
}

<!-- start of organiser profile page -->
<div class="container py-4">

    <!-- start of profile header -->
    <div class="raceday-profile-header mb-4">

        <h1>
            My Profile 👤
        </h1>

        <p class="mb-2">
            Manage your Organiser account information.
        </p>

        <span class="badge text-bg-success">
            Organiser 🌿
        </span>

    </div>
    <!-- end of profile header -->


    <div class="row justify-content-center">

        <div class="col-lg-7">

            <!-- start of profile picture editor -->
            <partial name="_ProfilePictureUpload" />
            <!-- end of profile picture editor -->
            <!-- start of personal information card -->
            <div class="card shadow-sm raceday-profile-card">

                <div class="card-body p-4 p-md-5">

                    <h3 class="mb-3">
                        Personal Information
                    </h3>


                    <!-- start of registration date -->
                    @if (ViewBag.DateRegistered != null)
                    {
                        @* start of if *@

                        <p class="text-muted small">

                            Member since
                            @(((DateTime)ViewBag.DateRegistered).ToString("dd MMM yyyy"))

                        </p>

                        @* end of if *@
                    }
                    <!-- end of registration date -->
                    <!-- start of profile form -->
                    <form asp-controller="Organiser"
                          asp-action="Profile"
                          method="post">

                        @Html.AntiForgeryToken()

                        <!-- display validation errors -->
                        <div asp-validation-summary="All"
                             class="text-danger mb-3">
                        </div>


                        <!-- start of first name -->
                        <div class="mb-3">

                            <label asp-for="FirstName"
                                   class="form-label">

                                First Name

                            </label>

                            <input asp-for="FirstName"
                                   class="form-control"
                                   placeholder="Enter your first name"
                                   autocomplete="given-name" />

                            <span asp-validation-for="FirstName"
                                  class="text-danger">
                            </span>

                        </div>
                        <!-- end of first name -->
                        <!-- start of last name -->
                        <div class="mb-3">

                            <label asp-for="LastName"
                                   class="form-label">

                                Last Name

                            </label>

                            <input asp-for="LastName"
                                   class="form-control"
                                   placeholder="Enter your last name"
                                   autocomplete="family-name" />

                            <span asp-validation-for="LastName"
                                  class="text-danger">
                            </span>

                        </div>
                        <!-- end of last name -->
                        <!-- start of email -->
                        <div class="mb-4">

                            <label asp-for="Email"
                                   class="form-label">

                                Email Address

                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   placeholder="Enter your email address"
                                   autocomplete="email" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                        </div>
                        <!-- end of email -->
                        <!-- start of action buttons -->
                        <div class="d-flex gap-3 flex-wrap">

                            <button type="submit"
                                    class="btn btn-primary">

                                Save Changes 💾

                            </button>

                            <a asp-controller="Organiser"
                               asp-action="Index"
                               class="btn btn-secondary">

                                Back to Dashboard 🌤️

                            </a>

                        </div>
                        <!-- end of action buttons -->

                    </form>
                    <!-- end of profile form -->

                </div>

            </div>
            <!-- end of personal information card -->

        </div>

    </div>

</div>
<!-- end of organiser profile page -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
